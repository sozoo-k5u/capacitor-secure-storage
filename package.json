{
  "author": "Sozoo Studio",
  "bugs": {
    "url": "https://github.com/sozoo-k5u/capacitor-secure-storage/issues"
  },
  "license": "MIT",
  "description": "Work with Secure Storage for iOS, Android",
  "swiftlint": "@ionic/swiftlint-config",
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "repository": {
    "url": "git+https://github.com/sozoo-k5u/capacitor-secure-storage.git",
    "type": "git"
  },
  "version": "1.1.0",
  "types": "dist/esm/index.d.ts",
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/docgen": "^0.3.0",
    "@capacitor/ios": "^7.4.3",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.4.2",
    "prettier-plugin-java": "^2.6.6",
    "rimraf": "^6.0.1",
    "rollup": "^4.30.1",
    "swiftlint": "^2.0.0",
    "typescript": "~4.1.5"
  },
  "prettier": "@ionic/prettier-config",
  "scripts": {
    "verify:ios": "xcodebuild -scheme CapacitorSecureStorage -destination generic/platform=iOS",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "docgen": "docgen --api SecureStoragePlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "prepublishOnly": "npm run build",
    "eslint": "eslint . --ext ts",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "clean": "rimraf ./dist",
    "verify:web": "npm run build",
    "watch": "tsc --watch",
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "swiftlint": "node-swiftlint"
  },
  "module": "dist/esm/index.js",
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3"
  },
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "CapacitorSecureStorage.podspec",
    "ios/Sources",
    "ios/Tests",
    "Package.swift"
  ],
  "main": "dist/plugin.cjs.js",
  "name": "capacitor-secure-storage",
  "unpkg": "dist/plugin.js"
}
